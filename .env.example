# LLM configuration. Keep real keys in a local .env file or user environment.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WIRE_API=responses

# Optional image generation
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_API_URL=
IMAGE_MODEL=

# Optional PaddleOCR service
PADDLEOCR_TOKEN=
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.5

# Workspace overrides are optional when running from the standard layout.
BID_WRITER_WORKSPACE=
BID_WRITER_RAW=
BID_WRITER_KNOWLEDGE=
BID_WRITER_DELIVERY=
BID_WRITER_PORT=8876
POSTGRES_DB=bid_writer
POSTGRES_USER=bid_writer
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=bidwriter
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
BID_WRITER_SESSION_SECRET=replace-with-at-least-32-random-characters
BID_WRITER_BOOTSTRAP_ADMIN=admin
BID_WRITER_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
BID_WRITER_RAW_HOST=../../01_原始标书库
BID_WRITER_KNOWLEDGE_HOST=../../02_知识库
BID_WRITER_DELIVERY_HOST=../../04_交付与报告
BID_WRITER_AUTO_PUBLISH_LOW_RISK=1
BID_WRITER_EMBEDDING_MODEL=BAAI/bge-m3
BID_WRITER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BID_WRITER_RERANK_MIN_SCORE=0.25
BID_WRITER_EMBEDDING_DEVICE=auto
HF_ENDPOINT=https://huggingface.co
BID_WRITER_OIDC_ISSUER=
BID_WRITER_OIDC_CLIENT_ID=
BID_WRITER_OIDC_CLIENT_SECRET=
BID_WRITER_OIDC_REDIRECT_URI=http://127.0.0.1:8876/api/auth/oidc/callback
